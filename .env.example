# ─ DB (docker-compose.yml 의 pgvector 컨테이너와 동일 ─
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ezinterview
DB_USER=eziuser
DB_PASSWORD=ezipass

# ─ LLM ─────────────────────────────────────────────
#  · 평가/질문/임베딩에 OpenAI 키가 반드시 필요합니다 (모듈 import 시점에 클라이언트 생성).
#  · 로컬 검증이 목적이라면 OPENAI_BASE_URL 을 Ollama OpenAI 호환 endpoint 로 돌려 쓸 수 있습니다.
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama 사용 시 주석 해제

# ─ Solar (선택) ────────────────────────────────────
#  · report_agent_v4o 의 일부 노드가 Upstage Solar Pro 2 를 호출합니다.
#  · 비워두면 해당 노드만 실패하고 나머지는 정상 동작.
SOLAR_API_KEY=

# ─ Vito STT (선택) ─────────────────────────────────
#  · 실시간 음성 면접만 사용. 텍스트 입력만으로 면접하는 경우 비워도 됨.
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=

# ─ Windows 콘솔 한글 출력 ──────────────────────────
PYTHONUTF8=1
